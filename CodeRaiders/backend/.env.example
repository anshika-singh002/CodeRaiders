# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file

# MongoDB Connection String (from MongoDB Atlas or local)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/coderaiders?appName=Cluster0

# JWT Secrets - generate strong random strings (e.g. openssl rand -base64 32)
ACCESS_TOKEN_SECRET=your_strong_random_secret_here
ACCESS_TOKEN_EXPIRATION=15m

REFRESH_TOKEN_SECRET=your_different_strong_random_secret_here
REFRESH_TOKEN_EXPIRATION=7d

# Environment
NODE_ENV=development
